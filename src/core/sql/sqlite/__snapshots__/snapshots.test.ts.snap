  "id" TEXT NOT NULL,
  CONSTRAINT "pk_matiere" PRIMARY KEY ("id")
);

CREATE TABLE "classe" (
  "id" TEXT NOT NULL,
  CONSTRAINT "pk_classe" PRIMARY KEY ("id")
);

CREATE TABLE "enseigner" (
  "enseignant_id" TEXT NOT NULL,
  "matiere_id" TEXT NOT NULL,
  "classe_id" TEXT NOT NULL,
  CONSTRAINT "pk_enseigner" PRIMARY KEY ("enseignant_id", "matiere_id", "classe_id"),
  CONSTRAINT "fk_enseigner_enseignant" FOREIGN KEY ("enseignant_id") REFERENCES "enseignant" ("id"),
  CONSTRAINT "fk_enseigner_matiere" FOREIGN KEY ("matiere_id") REFERENCES "matiere" ("id"),
  CONSTRAINT "fk_enseigner_classe" FOREIGN KEY ("classe_id") REFERENCES "classe" ("id")
);
"
`;

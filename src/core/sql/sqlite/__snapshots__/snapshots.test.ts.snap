exports[`snapshots SQLite > ternary.sqlite.sql 1`] = `
"PRAGMA foreign_keys = ON;

-- Generated by Modrise
-- SQLite dialect

CREATE TABLE "enseignant" (
  "id" TEXT NOT NULL,
  CONSTRAINT "pk_enseignant" PRIMARY KEY ("id")
);


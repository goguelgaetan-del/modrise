exports[`snapshots SQLite > composite-identifiers.sqlite.sql 1`] = `
"PRAGMA foreign_keys = ON;

-- Generated by Modrise
-- SQLite dialect

CREATE TABLE "ligne_commande" (
  "id" TEXT NOT NULL,
  "no_ligne" INTEGER NOT NULL,
  CONSTRAINT "pk_ligne_commande" PRIMARY KEY ("id", "no_ligne")
);
"
`;

exports[`snapshots SQLite > hotel.sqlite.sql 1`] = `
"PRAGMA foreign_keys = ON;

-- Generated by Modrise
-- SQLite dialect

CREATE TABLE "client" (
  "id_client" INTEGER NOT NULL,
  "nom" TEXT NOT NULL,
  "prenom" TEXT NOT NULL,
  "email" TEXT,
  "telephone" TEXT,
  CONSTRAINT "pk_client" PRIMARY KEY ("id_client"),
  CONSTRAINT "uq_client_email" UNIQUE ("email")
);

CREATE TABLE "chambre" (
  "id_chambre" INTEGER NOT NULL,
  "numero" TEXT NOT NULL,
  "type" TEXT NOT NULL,
  "etage" INTEGER,
  "prix_nuit" NUMERIC NOT NULL,
  CONSTRAINT "pk_chambre" PRIMARY KEY ("id_chambre"),
  CONSTRAINT "uq_chambre_numero" UNIQUE ("numero")
);

CREATE TABLE "reservation" (
  "id_reservation" INTEGER NOT NULL,
  "date_arrivee" TEXT NOT NULL,
  "date_depart" TEXT NOT NULL,
  "nombre_personnes" INTEGER NOT NULL,
  "statut" TEXT NOT NULL,
  "client_id_client" INTEGER NOT NULL,
  CONSTRAINT "pk_reservation" PRIMARY KEY ("id_reservation"),
  CONSTRAINT "fk_reservation_client" FOREIGN KEY ("client_id_client") REFERENCES "client" ("id_client")
);

CREATE TABLE "concerner" (
  "reservation_id_reservation" INTEGER NOT NULL,
  "chambre_id_chambre" INTEGER NOT NULL,
  "prix_convenu" NUMERIC,
  CONSTRAINT "pk_concerner" PRIMARY KEY ("reservation_id_reservation", "chambre_id_chambre"),
  CONSTRAINT "fk_concerner_reservation" FOREIGN KEY ("reservation_id_reservation") REFERENCES "reservation" ("id_reservation"),
  CONSTRAINT "fk_concerner_chambre" FOREIGN KEY ("chambre_id_chambre") REFERENCES "chambre" ("id_chambre")
);
"
`;

exports[`snapshots SQLite > many-to-many.sqlite.sql 1`] = `
"PRAGMA foreign_keys = ON;

-- Generated by Modrise
-- SQLite dialect

CREATE TABLE "commande" (
  "id" TEXT NOT NULL,
  CONSTRAINT "pk_commande" PRIMARY KEY ("id")
);

CREATE TABLE "produit" (
  "id" TEXT NOT NULL,
  CONSTRAINT "pk_produit" PRIMARY KEY ("id")
);

CREATE TABLE "contenir" (
  "commande_id" TEXT NOT NULL,
  "produit_id" TEXT NOT NULL,
  "quantite" INTEGER NOT NULL,
  CONSTRAINT "pk_contenir" PRIMARY KEY ("commande_id", "produit_id"),
  CONSTRAINT "fk_contenir_commande" FOREIGN KEY ("commande_id") REFERENCES "commande" ("id"),
  CONSTRAINT "fk_contenir_produit" FOREIGN KEY ("produit_id") REFERENCES "produit" ("id")
);
"
`;

